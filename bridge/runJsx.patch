+// Run arbitrary ExtendScript through the bridge panel and wait for its result
+server.tool(
+  "run-jsx",
+  "Run ExtendScript code in After Effects via the MCP Bridge Auto panel and wait for the result. " +
+  "The value of the script's last expression is returned (strings that are JSON are parsed). " +
+  "The code runs inside one undo group. Wrap long work in a function and return a small JSON-able summary.",
+  {
+    code: z.string().describe("ExtendScript source to evaluate"),
+    timeoutSeconds: z.number().min(1).max(600).optional().describe("How long to wait for completion (default 60)")
+  },
+  async ({ code, timeoutSeconds = 60 }) => {
+    const jsxDir = path.join(getAETempDir(), 'jsx');
+    fs.mkdirSync(jsxDir, { recursive: true });
+    const jobId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
+    const file = path.join(jsxDir, `${jobId}.jsx`);
+    fs.writeFileSync(file, code, 'utf8');
+
+    clearResultsFile();
+    writeCommandFile("runJsx", { file, jobId });
+
+    const commandFile = path.join(getAETempDir(), 'ae_command.json');
+    const resultFile = path.join(getAETempDir(), 'ae_mcp_result.json');
+    const deadline = Date.now() + timeoutSeconds * 1000;
+    while (Date.now() < deadline) {
+      await new Promise(r => setTimeout(r, 250));
+      try {
+        const cmd = JSON.parse(fs.readFileSync(commandFile, 'utf8'));
+        if (cmd.args?.jobId !== jobId) {
+          return { content: [{ type: "text", text: "Command file was replaced by another command before this job finished." }], isError: true };
+        }
+        if (cmd.status === "completed" || cmd.status === "error") {
+          const text = fs.readFileSync(resultFile, 'utf8');
+          let isError = cmd.status === "error";
+          try { isError = isError || JSON.parse(text).status === "error"; } catch { /* keep raw text */ }
+          return { content: [{ type: "text", text }], isError };
+        }
+      } catch {
+        // file mid-write; keep polling
+      }
+    }
+    return {
+      content: [{ type: "text", text: `Timed out after ${timeoutSeconds}s waiting for job ${jobId}. Is the MCP Bridge Auto panel open with Auto-run enabled? Use get-results to check later.` }],
+      isError: true
+    };
+  }
+);
+
