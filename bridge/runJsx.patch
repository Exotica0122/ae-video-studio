+// --- runJsx: evaluate a script file written by the MCP server ---
+// Only .jsx files directly inside ~/.ae-mcp-bridge/jsx are accepted.
+// The script's last expression value is returned as "result".
+function runJsx(args) {
+    var jsxFolder = new Folder(getBridgeFolder().fsName + "/jsx");
+    var scriptFile = new File(args.file || "");
+    if (!scriptFile.exists || !/\.jsx$/i.test(scriptFile.name) ||
+        scriptFile.parent.fsName !== jsxFolder.fsName) {
+        return JSON.stringify({ status: "error", jobId: args.jobId, message: "runJsx: file must be an existing .jsx inside " + jsxFolder.fsName });
     }
-    return bridgeFolder.fsName + "/ae_command.json";
+    var value;
+    app.beginUndoGroup("MCP runJsx");
+    try {
+        value = $.evalFile(scriptFile);
+    } finally {
+        app.endUndoGroup();
+    }
+    var out = null;
+    if (typeof value === "string") {
+        try { out = JSON.parse(value); } catch (e) { out = value; }
+    } else if (value !== undefined) {
+        try { out = JSON.parse(JSON.stringify(value)); } catch (e2) { out = String(value); }
+    }
+    return JSON.stringify({ status: "success", jobId: args.jobId, result: out });
